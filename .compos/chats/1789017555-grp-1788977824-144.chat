)\\n    21\\t\\n    22\\t;; Read the normal maps without our q wrapper. The actual fallback command\\n    23\\t;; is resolved again with key-binding at dispatch, so remaps remain effective.\\n    24\\t(define (dismiss--normal-command buf)\\n    25\\t  (let loop ((maps (buffer-keymaps buf)))\\n    26\\t    (cond ((null? maps) #f)\\n    27\\t          ((equal? (car maps) \\\"dismiss-mode-map\\\") (loop (cdr maps)))\\n    28\\t          (else\\n    29\\t            (let ((cmd (keymap-lookup (car maps) \\\"q\\\")))\\n    30\\t              (if cmd cmd (loop (cdr maps))))))))\\n    31\\t\\n    32\\t(define (buffer-dismissible? buf)\\n    33\\t  (and (buffer-known? buf) (buffer-read-only? buf)\\n    34\\t       (let ((cmd (dismiss--normal-command buf)))\\n    35\\t         (or (buffer-parent buf) (pair? (buffer-children buf))\\n    36\\t             (member cmd '(\\\"quit-window\\\" \\\"dired-quit\\\" \\\"collect-quit\\\"\\n    37\\t                           \\\"switch-quit\\\" \\\"overview-quit\\\" \\\"notmuch-back\\\"\\n    38\\t                           \\\"notmuch-quit\\\" \\\"peek-dismiss\\\"))))\\n    39\\t       #t))\\n    40\\t\\n    41\\t(public! 'buffer-parent \\\"(buffer-parent BUF) — BUF's live dismissal parent, or #f\\\")\\n    42\\t(public! 'buffer-children \\\"(buffer-children BUF) — BUF's live children, newest first\\\")\\n    43\\t(public! 'buffer-dismissible? \\\"(buffer-dismissible? BUF) — whether BUF offers child-first q dismissal\\\")\\n    44\\t\\n    45\\t(effects! '(write display))\\n    46\\t\\n    47\\t(define (buffer-child! parent child)\\n    48\\t  (unless (and (buffer-known? parent) (buffer-known? child))\\n    49\\t    (error \\\"A buffer relationship needs two known buffers\\\"))\\n    50\\t  (when (or (equal? parent child) (member parent (dismiss--descendants child)))\\n    51\\t    (error \\\"A buffer cannot be its own descendant\\\"))\\n    52\\t  (let ((old (buffer-parent child)))\\n    53\\t    (when old\\n    54\\t      (buffer-set-