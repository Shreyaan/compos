ansient lists and buffers visible elsewhere remain valid.\\n   122\\t(define (dismiss--close-child! child)\\n   123\\t  (let ((focus (active-window))\\n   124\\t        (parent (buffer-parent child)))\\n   125\\t    (if (and (buffer-path child) (buffer-modified? child))\\n   126\\t        (begin (message \\\"Buffer is modified — save it before dismissing\\\") #f)\\n   127\\t        (begin\\n   128\\t          (for-each\\n   129\\t            (lambda (row)\\n   130\\t              (when (equal? (cadr row) child)\\n   131\\t                (let* ((win (car row)) (rec (window-quit-restore win))\\n   132\\t                       (past (filter (lambda (b) (and (buffer-known? b)\\n   133\\t                                                     (not (equal? b child))))\\n   134\\t                                     (window-buffer-history win))))\\n   135\\t                  (cond\\n   136\\t                    ((and (popup-open?) (equal? win (popup-window))) (popup-dismiss!))\\n   137\\t                    ((and rec (equal? (cadr rec) 'window) (> (length (window-list)) 1))\\n   138\\t                     (delete-window-id! win))\\n   139\\t                    (else\\n   140\\t                      (window-set-buffer! win\\n   141\\t                        (if (pair? past) (car past) (or parent \\\"*scratch*\\\")))\\n   142\\t                      (window-history-set! win (if (pair? past) (cdr past) '()))))\\n   143\\t                  (window-quit-restore-forget! win))))\\n   144\\t            (window-list))\\n   145\\t          ;; A child displayed in another frame remains that frame's view.\\n   146\\t          (unless (let loop ((rows (window-list-all)))\\n   147\\t                    (and (pair? rows)\\n   148\\t                         (or (equal? (cadr (car rows)) child) (loop (cdr rows)))))\\n   149\\t            ;; Visible-first may close a child before its hidden descendants.\\n   150\\t            ;; Keep those descendants reachable for the parent's next q.\\n   1