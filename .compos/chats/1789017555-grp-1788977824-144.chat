)\\n422-\\n\" \"107:(define (peek--post-command!)\\n108-  (when *peek*\\n109-    (cond ((equal? (active-window) (list-ref *peek* 1))\\n110-           ;; the reader moved into the window by any road: it is theirs\\n111-           (set! *peek* #f))\\n112-          ((peek--still-here? *peek*) #t)\\n113-          (else (peek-discard!)))))\\n114-\\n115-;; Register once. A reload re-runs only the forms whose text changed, so\\n116-;; this flag survives it and the hook list gets no second entry. The\\n117-;; lambda looks the hook up by name at run time, so a reloaded\\n118-;; peek--post-command! is the one that runs.\\n119-(define *peek-hook-installed* #f)\\n120-\\n121-(add-hook! 'post-command-hook 'peek--post-command!)\\n\" \"708:(define (paredit--show-paren!)\\n709-  (let ((buf (current-buffer)))\\n710-    (when (minor-mode-on? buf \\\"paredit-mode\\\")\\n711-      (let* ((text (buffer-text buf))\\n712-             (p (point))\\n713-             (pair (and (equal? (par--mode (par--ctx text p)) 'code)\\n714-                        (paredit--paren-pair text p))))\\n715-        (if pair\\n716-            (overlay-set! buf 'paren\\n717-              (list (list (car pair) (+ (car pair) 1) \\\"paren-match\\\")\\n718-                    (list (cadr pair) (+ (cadr pair) 1) \\\"paren-match\\\")))\\n719-            (overlay-clear! buf 'paren))))))\\n720-\\n\" \"975:(define (morg--post-command-point-map!)\\n976-  (let ((buf (current-buffer)))\\n977-    (when (buffer-mode-is? buf \\\"morg-mode\\\") (morg-point-map! buf))))\\n978-\\n979-(add-hook! 'post-command-hook 'morg--post-command-point-map!)\\n980-\\n981-;; the older name: the keys are the keymap at point now\\n982-(define (morg-arm-block-keys! buf) (morg-point-map! buf))\\n983-\\n984-(define-mode \\\"morg-mode\\\"\\n985-  (lambda ()\\n986-    ;; Morg owns structure and the plain faces. The prose presentation is\\n987-    ;; writing-mode's; preview-mode draws the page in place.\\n\")",false]],"role":"assistant"},{"blocks":[["t