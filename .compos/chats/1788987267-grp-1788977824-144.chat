 the bookmarks. s lists the page's group, M-n and M-p walk\\nthe tabs. C-s searches to any link.\" use \"(run-command \\\"browse-mode\\\")\") (kind \"function\" name \"cache-declare!\" sig \"(cache-declare! BUF FETCH RENDER TTL)\" doc \"FETCH is (buf k): do the work off the UI lane and call (k DATA), (k #f) on failure; RENDER is (buf data); TTL seconds, #f = manual refresh only\" domain \"buffers\" category \"buffers\" qualified-name \"core/cache-declare!\" package \"editor\" namespace \"core\" domain \"buffers\" effects (\"unknown\")) (kind \"variable\" name \"spotify-url\" doc \"The page the player runs in.\" qualified-name \"spotify/spotify-url\" package \"spotify\" namespace \"spotify\" domain \"spotify\" effects (\"write\") use \"(customize-save! 'spotify-url VALUE)\") (kind \"function\" name \"buffer-raw-link\" sig \"(buffer-raw-link [NAME])\" doc \"a URL that serves the buffer text as plain text\" domain \"buffers\" category \"buffers\" qualified-name \"core/buffer-raw-link\" package \"editor\" namespace \"core\" domain \"buffers\" effects (\"read\")) (kind \"recipe\" task \"read my rss feeds\" name \"read my rss feeds\" run \"(feeds)\" inputs () qualified-name \"feeds/read my rss feeds\" package \"feeds\" namespace \"feeds\" domain \"web\" effects (\"write\" \"external\") use \"(feeds)\") (kind \"variable\" name \"browse-download-directory\" doc \"Where `d` saves a link or a page.\" qualified-name \"web/browse-download-directory\" package \"web\" namespace \"web\" domain \"web\" effects (\"write\") use \"(customize-save! 'browse-download-directory VALUE)\") (kind \"command\" name \"browse-download\" doc \"Save the link at point, else the page, to the download directory\" key #f qualified-name \"web/browse-download\" package \"web\" namespace \"web\" domain \"web\" effects (\"write\" \"external\") use \"(run-command \\\"browse-download\\\")\") (kind \"function\" name \"training-document-path\" sig \"(training-document-path)\" doc \"the repository's docs/train