ver/web-server-detail\" package \"web-server\" namespace \"web-server\" domain \"system\" effects (\"read\" \"external\")) (kind \"function\" name \"browser-file-path?\" sig \"(browser-file-path? PATH)\" doc \"return #t when PATH uses the browser file viewer\" domain \"ui\" category \"ui\" qualified-name \"file-view/browser-file-path?\" package \"file-view\" namespace \"file-view\" domain \"files\" effects (\"pure\")) (kind \"command\" name \"browse-top\" doc \"Go to the root of this page's site\" key #f qualified-name \"web/browse-top\" package \"web\" namespace \"web\" domain \"web\" effects (\"write\" \"external\") use \"(run-command \\\"browse-top\\\")\")) globals ())",false]],"role":"assistant"},{"blocks":[["tool-use","toolu_01DZvL4of6iRGwgUfcuSg7vX","mcp__compos__eval-scheme",""]],"role":"assistant"},{"blocks":[["tool-use","toolu_01Ft8pCMyTEzVSfRovF9Spk6","mcp__compos__eval-scheme",""]],"role":"assistant"},{"blocks":[["tool-result","toolu_01DZvL4of6iRGwgUfcuSg7vX","\"apps/compos_core/lib/compos/core/google.ex\\napps/compos_core/lib/compos/core/mcp/conn.ex\\napps/compos_core/lib/compos/core/embedding_index.ex\\napps/compos_core/lib/compos/core/llmdb.ex\\n---\\napps/compos_core/priv/packages/agent-connectors.scm:172:    (string-append \\\"curl -s --max-time 20 '\\\" url \\\"'\\\")\\napps/compos_core/priv/packages/doom.scm:151:;; large: the IWAD is four megabytes and the engine is two. curl writes a\\napps/compos_core/priv/packages/doom.scm:158:         (cmd (string-append \\\"curl -fsSL --max-time 600 -o \\\" (doom--sh-quote part)\\napps/compos_core/priv/packages/feeds.scm:9:;;; The fetch is curl and xsltproc (web/parsers/feed.xsl), off the UI\\napps/compos_core/priv/packages/feeds.scm:131:;;; One shell command fetches every subscription: curl the XML, and\\napps/compos_core/priv/packages/feeds.scm:165:               \\\"curl -sL --max-time 15 \\\" (feeds--shell-quote u)\\napps/compos_core/priv/packages/feeds.scm:171:(define (feeds--curl-items urls k)\\napps/compos_core/priv/packages/feeds.scm:177:(define *feeds-fetch* feeds--curl-items)\\napps/compos_core/priv/packages/feeds.scm:217:      \\\"body=$(curl -sL --max-time 15 \\\" u \\\" 2>/dev/null); \\\"\\napps/compos_core/priv/packages/feeds.scm:228:(define (feeds--curl-discover url k)\\napps/compos_core/priv/packages/feeds.scm:232:(define *feeds-discover* feeds--curl-discover)\\napps/compos_core/priv/packages/graphql.scm:15:;;; the registry. It is also not in the process list: curl reads the URL,\\napps/compos_core/priv/packages/graphql.scm:35:(defcustom 'graphql-curl-program \\\"curl\\\"\\napps/compos_core/priv/packages/graphql.scm:36:  \\\"The curl executable the GraphQL client shells out to.\\\" 'group 'graphql)\\napps/compos_core/priv/packages/graphql.scm:116:;; curl reads a quoted config value with backslash escapes. The backslash\\napps/compos_core/priv/packages/graphql.scm:146:(define (graphql--curl url headers body)\\napps/compos_core/priv/packages/graphql.scm:152:                 (string-append graphql-curl-program \\\" --config \\\"\\napps/compos_core/priv/packages/graphql.scm:158:;; (STATUS BODY). curl itself failing prints no status line at all, so a\\napps/compos_core/priv/packages/graphql.scm:195:                      (graphql--curl (cadr e) (nth 2 e)\\napps/compos_core/priv/packages/graphql.scm:206:             ;; curl names itself in its own complaints, so this does not\\napps/compos_core/priv/packages/notmuch.scm:1254:(define (nm--curl-text url)\\napps/compos_core/priv/packages/notmuch.scm:1255:  (shell-command->string (string-append \\\"curl -sL --max-time 15 \\\" (nm--quote url)) (default-directory)))\\napps/compos_core/priv/packages/notmuch.scm:1265:                      (string-append \\\"curl -sL --max-time 15 -X POST \\\"\\napps/compos_core/priv/packages/notmuch.scm:1274:       (if (nm--looks-unsubscribed? (nm--curl-text https))\\napps/compos_core/priv/packages/notmuch.scm:1283:            ((nm--looks-unsubscribed? (nm--curl-text body-link))\\napps/